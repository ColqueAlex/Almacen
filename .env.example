# Copiar este archivo como .env y completar los valores.

# --- Django ---
# Generar una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# True en desarrollo, False en producción
DEBUG=True
# Lista separada por comas
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Base de datos MySQL ---
DB_NAME=Almacen_ElRefugio
DB_USER=myuser
DB_PASSWORD=mypassword
DB_HOST=127.0.0.1
DB_PORT=3307

# --- Correo SMTP (alertas de vencimiento / stock) ---
# Para Gmail usar una "contraseña de aplicación", no la contraseña de la cuenta.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
ALERTAS_EMAIL_DESTINATARIO=

# --- Backups (python manage.py backup_db) ---
# Ruta completa a mysqldump.exe (vacío = buscarlo en el PATH).
# Ejemplos: C:\xampp\mysql\bin\mysqldump.exe
#           C:\Program Files\MySQL\MySQL Server 9.4\bin\mysqldump.exe
MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
