# --- Python ---
__pycache__/
*.py[cod]
*$py.class

# --- Entornos virtuales ---
venv/
.venv/
env/
ENV/

# --- Variables de entorno / secretos ---
.env
.env.*
!.env.example

# --- Base de datos local ---
db.sqlite3

# --- Archivos estáticos y media generados ---
staticfiles/
media/

# --- Logs (salida de tareas programadas: scripts/alertas_vencimiento.bat) ---
logs/
*.log

# --- Backups de la base de datos (contienen datos reales: nunca a Git) ---
backups/

# --- Gráficos generados por analitica_el_refugio.py ---
reportes_analitica/
static/analitica/*
!static/analitica/.gitkeep

# --- Editores / SO ---
.vscode/
.idea/
Thumbs.db
.DS_Store
